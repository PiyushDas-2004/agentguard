{% extends "base.html.j2" %}{% block title %}AgentGuard runs{% endblock %}
{% block body %}
<h2>Risk score trend</h2>
<div class="panel">{% if points %}
<svg viewBox="-10 -10 640 190" width="100%" height="200" role="img" aria-label="risk trend">
  <line x1="0" y1="160" x2="600" y2="160" stroke="var(--line)"/><line x1="0" y1="96" x2="600" y2="96" stroke="var(--line)" stroke-dasharray="4 4"/>
  <text x="602" y="99">40</text>
  <polyline fill="none" stroke="var(--accent)" stroke-width="2" points="{% for p in points %}{{ p.x }},{{ p.y }} {% endfor %}"/>
  {% for p in points %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="4" fill="var(--accent)"><title>{{ p.label }}: {{ p.risk }}</title></circle>{% endfor %}
</svg>{% else %}<p class="muted">No finished runs yet. Run <code>agentguard run -c examples/demo.yaml --offline</code>.</p>{% endif %}</div>
<h2>Compare two runs</h2>
<div class="panel"><form hx-get="/compare" hx-target="#cmp" hx-swap="innerHTML">
  <select name="a" aria-label="run A">{% for r in runs %}<option value="{{ r.id }}">{{ r.id }} · {{ r.name }}</option>{% endfor %}</select>
  <select name="b" aria-label="run B">{% for r in runs %}<option value="{{ r.id }}" {% if loop.index == 1 %}selected{% endif %}>{{ r.id }} · {{ r.name }}</option>{% endfor %}</select>
  <button type="submit">Compare</button></form><div id="cmp"></div></div>
<h2>Runs</h2>
<div class="panel"><table id="runs"><tr><th>Run</th><th>Name</th><th>Target</th><th>Status</th><th>Risk</th><th>Grade</th></tr>
{% for r in runs %}<tr><td><a href="/runs/{{ r.id }}">{{ r.id }}</a></td><td>{{ r.name }}</td><td class="muted">{{ r.target_name }}</td>
<td>{{ r.status }}</td><td>{{ '%.1f'|format(r.risk_score) if r.risk_score is not none else '—' }}</td><td>{{ r.grade or '—' }}</td></tr>{% endfor %}
</table></div>
{% endblock %}
