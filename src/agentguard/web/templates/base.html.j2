<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}AgentGuard{% endblock %}</title>
<script src="/static/htmx.min.js" nonce="{{ nonce }}" defer></script>
<style>
:root{--bg:#f7f8fa;--panel:#fff;--ink:#1d2330;--muted:#5d6678;--line:#e2e6ee;--accent:#3355cc;--ok:#1e8a4c;--ok-bg:#e5f5ec;--bad:#c62828;--bad-bg:#fdeaea;--warn:#a86400;--warn-bg:#fff3dd;--code:#f1f3f7}
@media (prefers-color-scheme:dark){:root{--bg:#0f1218;--panel:#171b24;--ink:#e6e9ef;--muted:#9aa3b5;--line:#2a3140;--accent:#7d9bff;--ok:#5ad08a;--ok-bg:#12301f;--bad:#ff6b6b;--bad-bg:#3a1717;--warn:#ffb74d;--warn-bg:#33270f;--code:#10141b}}
*{box-sizing:border-box}body{margin:0;font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
header{display:flex;flex-wrap:wrap;gap:14px;align-items:center;padding:12px 16px;background:var(--panel);border-bottom:1px solid var(--line)}
header a{color:var(--ink);text-decoration:none}header .brand{font-weight:800;margin-right:auto}
main{max-width:980px;margin:0 auto;padding:20px 16px 60px}a{color:var(--accent)}h1{font-size:24px}h2{font-size:18px;margin-top:28px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;margin:12px 0;overflow-x:auto}
label{display:block;font-weight:600;margin:12px 0 4px}.hint{color:var(--muted);font-size:13px;font-weight:400}
input[type=text],input[type=email],input[type=password],input[type=url],input[type=number],select,textarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
textarea{min-height:90px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px}
button,.btn{font:inherit;font-weight:600;padding:8px 16px;border-radius:8px;border:1px solid var(--accent);background:var(--accent);color:#fff;cursor:pointer;text-decoration:none;display:inline-block}
button.secondary,.btn.secondary{background:transparent;color:var(--accent)}button.danger{background:var(--bad);border-color:var(--bad)}
table{border-collapse:collapse;width:100%}th,td{text-align:left;padding:8px;border-bottom:1px solid var(--line)}th{font-size:12px;text-transform:uppercase;color:var(--muted)}
.badge{padding:1px 8px;border-radius:999px;font-size:12px;font-weight:700}.ok{background:var(--ok-bg);color:var(--ok)}.bad{background:var(--bad-bg);color:var(--bad)}.warn{background:var(--warn-bg);color:var(--warn)}
.error{background:var(--bad-bg);color:var(--bad);padding:10px 12px;border-radius:8px}.success{background:var(--ok-bg);color:var(--ok);padding:10px 12px;border-radius:8px}
code,pre{background:var(--code);border-radius:6px}code{padding:1px 5px}pre{padding:10px;overflow-x:auto;font-size:13px}
.inline{display:inline}.muted{color:var(--muted)}.grid{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.check{font-weight:400;display:flex;gap:8px;align-items:center;margin:4px 0}
progress{width:100%;height:12px}
</style>
</head>
<body hx-headers='{"X-CSRF-Token": "{{ csrf_token }}"}'>
<header>
  <a class="brand" href="/">🛡 AgentGuard</a>
  {% if user %}
  <a href="/scans">Scans</a><a href="/targets">Targets</a><a href="/account">Account</a>
  <form class="inline" method="post" action="/logout"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="secondary" type="submit">Sign out</button></form>
  {% else %}
  <a href="/login">Sign in</a><a class="btn" href="/signup">Create account</a>
  {% endif %}
</header>
<main>{% block body %}{% endblock %}</main>
</body>
</html>
