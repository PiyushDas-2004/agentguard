{% extends "base.html.j2" %}{% block title %}Create account · AgentGuard{% endblock %}
{% block body %}
<h1>Create account</h1>
<div class="panel">
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="/signup" autocomplete="on">
<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label for="email">E-mail</label><input id="email" type="email" name="email" value="{{ email }}" required maxlength="254" autocomplete="email">
<label for="password">Password <span class="hint">(at least 12 characters)</span></label>
<input id="password" type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password">
{% if not settings.open_signup %}<label for="invite_code">Invite code</label><input id="invite_code" type="text" name="invite_code" required maxlength="200" autocomplete="off">{% endif %}
<p><button type="submit">Create account</button></p>
</form>
<p class="muted">Already registered? <a href="/login">Sign in</a></p>
</div>
{% endblock %}
